<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>奶蛙桌宠 · 单文件版</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { height: 100%; overscroll-behavior: none; }
  body {
    font-family: ui-rounded, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
    background: radial-gradient(1200px 800px at 70% 20%, #fdf6e3 0%, #f5e9c8 45%, #ecd9a8 100%);
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  header {
    position: absolute; top: 22px; left: 0; right: 0;
    text-align: center; pointer-events: none; z-index: 5;
  }
  header h1 { font-size: 26px; color: #6b5322; letter-spacing: 2px; font-weight: 700; }
  header p { margin-top: 6px; font-size: 13px; color: #a08a55; }
  #tip {
    position: absolute; left: 50%; top: 38%;
    transform: translate(-50%, 0);
    background: rgba(255,255,255,.9); color: #6b5322;
    padding: 10px 18px; border-radius: 14px; font-size: 14px;
    box-shadow: 0 6px 24px rgba(107,83,34,.18);
    pointer-events: none; z-index: 6;
    transition: opacity .6s;
  }
  #tip.hide { opacity: 0; }
  #stage {
    position: absolute; left: 0; right: 0; top: 0; bottom: 118px;
    overflow: hidden; z-index: 15;
  }
  #pet {
    position: absolute; left: 0; top: 0;
    cursor: grab; touch-action: none; user-select: none; -webkit-user-select: none;
    will-change: transform;
  }
  #pet.grabbing { cursor: grabbing; }
  footer {
    position: absolute; left: 50%; bottom: 18px;
    transform: translateX(-50%);
    display: flex; gap: 10px; align-items: center; flex-wrap: wrap; justify-content: center;
    background: rgba(255,255,255,.88); backdrop-filter: blur(8px);
    border-radius: 18px; padding: 12px 16px;
    box-shadow: 0 8px 30px rgba(107,83,34,.16);
    z-index: 20; max-width: 94vw;
  }
  footer button {
    border: 2px solid transparent; background: #fff;
    color: #6b5322; border-radius: 12px; padding: 8px 16px;
    font-size: 14px; cursor: pointer; font-weight: 600; font-family: inherit;
    box-shadow: 0 2px 8px rgba(107,83,34,.10);
  }
  footer button.active { border-color: #e8a83a; background: #fff3d6; }
  footer .sep { width: 1px; height: 26px; background: #e5d5aa; }
  footer #sndBtn.off { background: #f1ede0; }
</style>
</head>
<body>
<header>
  <h1>🐸 奶蛙桌宠 · 单文件版</h1>
  <p>单击微笑 · 1.5 秒内连点 5 次大笑 · 拖住它甩出去！</p>
</header>
<div id="tip">把奶蛙拖起来，朝任意方向甩出去试试 🎯</div>
<div id="stage"><canvas id="pet"></canvas></div>
<footer>
  <button data-mood="idle" class="active" title="58 帧循环呼吸">待机</button>
  <button data-mood="smile" title="9 帧 · 750ms 单次">微笑</button>
  <button data-mood="laugh" title="68 帧 · 5667ms 单次">大笑</button>
  <button data-mood="cry" title="39 帧循环">哭泣</button>
  <span class="sep"></span>
  <button id="sndBtn">🔊 音效开</button>
</footer>
<script>
/* ============================================================
 * 奶蛙桌宠 · 单文件复刻版（vanilla JS，零依赖）
 * 交互参数逐项对齐原版桌宠（43aquaris/naiwa · main.cpp）与
 * React 组件版（react/src/components/NaiwaPet.tsx）：
 *   - 单击 → smile（750ms 单次）
 *   - 1.5 秒内连点 5 次 → laugh（5667ms 单次，音效延迟 300ms）
 *   - 拖拽松手 → 甩飞：重力 0.4px/f²、空气阻力 ×0.98/f、
 *     反弹保留 0.70、停止阈值 0.5px/f、初速度取最近 100ms 轨迹
 *   - 撞壁挤压：上下 0.40 / 左右 0.20，压缩 100ms + 复原 150ms
 *   - 60fps 固定步长物理；12fps 帧动画；DPR 自适应渲染
 * 资源全部 base64 内嵌，双击即可离线运行。
 * ============================================================ */

/* ---------- 素材参数（与雪碧图生成脚本一致） ---------- */
var PET = {
  frameW: 259, frameH: 359,       // 单元格尺寸（雪碧图已半分辨率化）
  fps: 12,                        // 原桌宠 Animation::fps
  cols: 8,                        // row-major 8 列
  forms: {
    idle:  { start: 0,   frames: 58, loop: true  },
    smile: { start: 58,  frames: 9,  loop: false },
    laugh: { start: 67,  frames: 68, loop: false },
    cry:   { start: 135, frames: 39, loop: true  }
  },
  // 身体内容碰撞盒（占帧比例，原版 idle_01 bbox 94,30,329,657 / 518×718）
  body: { l: 94/518, t: 30/718, r: (518-423)/518, b: (718-687)/718 }
};

var FRAME_MS      = 1000 / 60;   // 物理固定步长
var CLICK_WINDOW  = 1500;        // 连点判定窗口
var LAUGH_COUNT   = 5;           // 连点次数阈值
var LAUGH_MS      = 5667;        // 大笑时长（原版 stateEnd）
var SMILE_MS      = 750;         // 微笑时长
var DRAG_THRESHOLD = 6;          // 拖拽判定阈值（px 累计位移）
var REF_H = (718 / 518) * 180;   // 原版 laugh 显示高度基准，物理常数按此缩放

/* ---------- 内嵌资源（base64 只存一份，多处引用） ---------- */
var ATLAS_B64 = '__ATLAS_B64__';
var SMILE_B64 = '__SMILE_B64__';
var LAUGH_B64 = '__LAUGH_B64__';
var ATLAS_SRC = 'data:image/webp;base64,' + ATLAS_B64;

/* ---------- DOM ---------- */
var stage  = document.getElementById('stage');
var canvas = document.getElementById('pet');
var ctx    = canvas.getContext('2d');
var tip    = document.getElementById('tip');
var sndBtn = document.getElementById('sndBtn');

/* ---------- 状态 ---------- */
var SIZE  = 210;                       // 显示高度 px
var propsMood = 'idle';                // 外部驱动的情绪（面板按钮）
var localMood = null;                  // 点击触发的情绪 { mood, until }
var anim   = { mood: 'idle', frame: 0, elapsed: 0 };
var clicks = [];                       // 连点时间戳
var soundOn = true;
var actx = null, sndBuf = {};          // WebAudio
var atlas = null;                      // 雪碧图 Image
var phys = {
  x: 160, y: 200, vx: 0, vy: 0,
  drag: null,                          // { offX, offY, moved, t0, dragged, hist[] }
  squish: null                         // { t, vertical }
};
var didInit = false;

/* ---------- 渲染尺寸 ---------- */
var dpr = Math.min(2, window.devicePixelRatio || 1);
var dispH = SIZE;
var dispW = SIZE * (PET.frameW / PET.frameH);
canvas.width  = Math.round(dispW * dpr);
canvas.height = Math.round(dispH * dpr);
canvas.style.width  = dispW + 'px';
canvas.style.height = dispH + 'px';

var k = dispH / REF_H;
var GRAV = 0.4 * k, DRAG_C = 0.98, BOUNCE = 0.70, STOP = 0.5 * k, SIDE_STOP = 3 * k;

/* ---------- 音效 ---------- */
function ensureAudio() {
  if (!actx) {
    var Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    actx = new Ctx();
  }
  if (actx.state === 'suspended') actx.resume();
  return actx;
}
function base64ToArrayBuffer(b64) {
  var bin = atob(b64), len = bin.length, bytes = new Uint8Array(len);
  for (var i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
  return bytes.buffer;
}
function loadSound(kind, b64) {
  var a = ensureAudio();
  if (!a) return;
  sndBuf[kind] = 'loading';
  a.decodeAudioData(base64ToArrayBuffer(b64), function (buf) { sndBuf[kind] = buf; },
    function () { sndBuf[kind] = null; });
}
function petVoice(kind) {
  if (!soundOn) return;
  var a = ensureAudio();
  if (!a || !sndBuf[kind] || sndBuf[kind] === 'loading') return;
  var src = a.createBufferSource();
  src.buffer = sndBuf[kind];
  var gain = a.createGain();
  gain.gain.value = kind === 'laugh' ? 0.9 : 0.7;
  src.connect(gain); gain.connect(a.destination);
  // 大笑音效延迟 300ms（对齐原版）
  src.start(a.currentTime + (kind === 'laugh' ? 0.3 : 0));
}

/* ---------- 情绪决策 ---------- */
function effectiveMood(now) {
  if (localMood && now < localMood.until) return localMood.mood;
  localMood = null;
  return propsMood;
}

/* ---------- 挤压变形（返回 [scaleX, scaleY]） ---------- */
function squishScale(now) {
  if (!phys.squish) return [1, 1];
  var e = now - phys.squish.t;
  var amt = phys.squish.vertical ? 0.4 : 0.2;
  var sq, ex;
  if (e < 100)      { var t1 = e / 100;         sq = 1 - amt * t1;          ex = 1 + amt * t1; }
  else if (e < 250) { var t2 = (e - 100) / 150; sq = (1 - amt) + amt * t2;  ex = (1 + amt) - amt * t2; }
  else { phys.squish = null; return [1, 1]; }
  return phys.squish.vertical ? [ex, sq] : [sq, ex];
}

/* ---------- 边界缓存 ---------- */
var bounds = { w: 0, h: 0 };
function refreshBounds() {
  var r = stage.getBoundingClientRect();
  bounds = { w: r.width, h: r.height };
}
window.addEventListener('resize', refreshBounds);

/* ---------- 物理步进（固定 60Hz） ---------- */
function step(now) {
  var p = phys;
  if (bounds.w > 0) {
    if (p.drag) {
      p.vx = 0; p.vy = 0;              // 拖拽中不做力累积
    } else {
      p.vy += GRAV;
      p.vx *= DRAG_C; p.vy *= DRAG_C;
      p.x += p.vx; p.y += p.vy;
      var bl = p.x - dispW / 2 + PET.body.l * dispW;
      var br = p.x + dispW / 2 - PET.body.r * dispW;
      var bt = p.y - dispH / 2 + PET.body.t * dispH;
      var bb = p.y + dispH / 2 - PET.body.b * dispH;
      if (bl < 0) {
        p.x -= bl;
        p.vx = Math.abs(p.vx) < SIDE_STOP ? 0 : Math.abs(p.vx) * BOUNCE;
        p.squish = { t: now, vertical: false };
      } else if (br > bounds.w) {
        p.x -= br - bounds.w;
        p.vx = Math.abs(p.vx) < SIDE_STOP ? 0 : -Math.abs(p.vx) * BOUNCE;
        p.squish = { t: now, vertical: false };
      }
      if (bt < 0) {
        p.y -= bt;
        p.vy = Math.abs(p.vy) * BOUNCE;
        p.squish = { t: now, vertical: true };
      } else if (bb > bounds.h) {
        p.y -= bb - bounds.h;
        p.vy = Math.abs(p.vy) < STOP ? 0 : -Math.abs(p.vy) * BOUNCE;
        p.squish = { t: now, vertical: true };
      }
    }
  }

  /* 帧推进（12fps；情绪切换从头播） */
  var m = effectiveMood(now);
  if (m !== anim.mood) anim = { mood: m, frame: 0, elapsed: 0 };
  anim.elapsed += FRAME_MS;
  if (anim.elapsed >= 1000 / PET.fps) {
    anim.elapsed -= 1000 / PET.fps;
    var def = PET.forms[anim.mood];
    if (anim.frame + 1 < def.frames) anim.frame++;
    else if (def.loop) anim.frame = 0;
    /* 单次形态停在末帧，由 local/props 到期回落 */
  }
}

/* ---------- 绘制 ---------- */
function draw(now) {
  var def = PET.forms[anim.mood];
  var gi = def.start + Math.min(anim.frame, def.frames - 1);
  var col = gi % PET.cols, row = Math.floor(gi / PET.cols);
  var sc = squishScale(now);
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  ctx.save();
  var cx = canvas.width / 2, cy = canvas.height / 2;
  ctx.translate(cx, cy);
  ctx.scale(sc[0], sc[1]);
  ctx.translate(-cx, -cy);
  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = 'high';
  ctx.drawImage(atlas,
    col * PET.frameW, row * PET.frameH, PET.frameW, PET.frameH,
    0, 0, canvas.width, canvas.height);
  ctx.restore();
}

/* ---------- 主循环（固定步长 + 追帧上限） ---------- */
var last = 0, acc = 0;
function loop(now) {
  requestAnimationFrame(loop);
  var dt = now - last;
  last = now;
  if (dt > 200) dt = 200;              // 页签切回防追帧爆发
  acc += dt;
  var n = 0;
  while (acc >= FRAME_MS && n++ < 12) { step(now); acc -= FRAME_MS; }
  canvas.style.transform = 'translate(' + (phys.x - dispW / 2) + 'px,' + (phys.y - dispH / 2) + 'px)';
  canvas.classList.toggle('grabbing', !!phys.drag);
  draw(now);
}

/* ---------- 交互绑定 ---------- */
function layerPos(ev) {
  var lr = stage.getBoundingClientRect();
  return { x: ev.clientX - lr.left, y: ev.clientY - lr.top };
}

canvas.addEventListener('pointerdown', function (ev) {
  ev.preventDefault();
  try { canvas.setPointerCapture(ev.pointerId); } catch (e) {}
  var pt = layerPos(ev);
  phys.drag = {
    offX: pt.x - phys.x,
    offY: pt.y - phys.y,
    moved: 0, t0: performance.now(), dragged: false,
    hist: [{ t: performance.now(), x: phys.x, y: phys.y }]
  };
  phys.vx = 0; phys.vy = 0;
});

canvas.addEventListener('pointermove', function (ev) {
  var d = phys.drag;
  if (!d) return;
  var pt = layerPos(ev);
  var nx = pt.x - d.offX, ny = pt.y - d.offY;
  d.moved += Math.hypot(nx - phys.x, ny - phys.y);
  if (d.moved > DRAG_THRESHOLD) d.dragged = true;
  phys.x = nx; phys.y = ny;
  var now = performance.now();
  d.hist.push({ t: now, x: nx, y: ny });
  while (d.hist.length > 2 && now - d.hist[0].t > 100) d.hist.shift();
});

function finishDrag() {
  var d = phys.drag;
  if (!d) return;
  phys.drag = null;
  var now = performance.now();

  if (!d.dragged && now - d.t0 < 500) {
    /* 点击：大笑期间忽略；连点 5 次大笑，否则微笑 */
    var busy = localMood && localMood.mood === 'laugh' && now < localMood.until;
    if (!busy) {
      clicks = clicks.filter(function (t) { return now - t < CLICK_WINDOW; });
      clicks.push(now);
      if (clicks.length >= LAUGH_COUNT) {
        clicks = [];
        localMood = { mood: 'laugh', until: now + LAUGH_MS };
        petVoice('laugh');
      } else {
        localMood = { mood: 'smile', until: now + SMILE_MS };
        petVoice('smile');
      }
    }
    return;
  }
  /* 甩飞：初速度 = 最近 100ms 位移 / 帧数（px/frame） */
  var h = d.hist;
  if (h.length >= 2) {
    var first = h[0];
    var dt = now - first.t;
    if (dt > 12) {
      var frames = dt / FRAME_MS;
      phys.vx = (phys.x - first.x) / frames;
      phys.vy = (phys.y - first.y) / frames;
    }
  }
}
canvas.addEventListener('pointerup', finishDrag);
canvas.addEventListener('pointercancel', finishDrag);

/* ---------- 控制面板 ---------- */
var moodBtns = document.querySelectorAll('footer button[data-mood]');
moodBtns.forEach(function (btn) {
  btn.addEventListener('click', function () {
    propsMood = btn.getAttribute('data-mood');
    localMood = null;
    anim = { mood: propsMood, frame: 0, elapsed: 0 };
    moodBtns.forEach(function (b) { b.classList.toggle('active', b === btn); });
    if (soundOn && (propsMood === 'smile' || propsMood === 'laugh')) petVoice(propsMood);
  });
});
sndBtn.addEventListener('click', function () {
  soundOn = !soundOn;
  sndBtn.classList.toggle('off', !soundOn);
  sndBtn.textContent = soundOn ? '🔊 音效开' : '🔇 音效关';
  if (soundOn) ensureAudio();
});

/* 提示气泡 8 秒后淡出 */
setTimeout(function () { tip.classList.add('hide'); }, 8000);

/* ---------- 启动 ---------- */
function init() {
  refreshBounds();
  if (!didInit && bounds.w > 0) {
    didInit = true;
    phys.x = Math.max(dispW / 2 + 10, bounds.w * 0.18);   // 初始落点：左上方入场
    phys.y = bounds.h * 0.3;
  }
  last = performance.now();
  requestAnimationFrame(loop);
}

/* 预解码音效（首个用户手势后可立即播放） */
function preloadAudio() {
  loadSound('smile', SMILE_B64);
  loadSound('laugh', LAUGH_B64);
  window.removeEventListener('pointerdown', preloadAudio);
}
window.addEventListener('pointerdown', preloadAudio);

atlas = new Image();
atlas.decoding = 'async';
atlas.onload = function () {
  init();
  /* 首帧先画出来，同时暖机音频上下文（部分浏览器需要手势才放行） */
  try { ensureAudio(); } catch (e) {}
};
atlas.src = ATLAS_SRC;
</script>
</body>
</html>
